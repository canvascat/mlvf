{
	"compilerOptions": {
		"target": "ES2021",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"lib": ["es2023", "dom"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"paths": { "@/*": ["./admin/app/*"] }
	},
	"exclude": ["remotion.config.ts", "admin", "vite.config.mts", "drizzle.config.ts", "tmp"]
}
